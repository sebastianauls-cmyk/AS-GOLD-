# Public Supabase configuration is currently defined in app/modules/services/supabaseConfig.js.
# Payment secrets are server-only. Never prefix these variables with NEXT_PUBLIC_.
SUMUP_PAYMENT_MODE=sandbox
SUMUP_API_KEY=
SUMUP_MERCHANT_CODE=
SUPABASE_SECRET_KEY=
APP_BASE_URL=https://app-gold-workspace.vercel.app

# The shared access password and Sebastian's separate programming master
# password are created once on the private in-app setup page. No plain password
# belongs in an environment variable or in the source code.
TEAM_MASTER_APPROVER_LABEL=Sebastian Auls
